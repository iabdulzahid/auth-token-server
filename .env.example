# .env.example — Auth Token Server environment variables
#
# Copy this file to .env and fill in the values before running locally.
# .env is gitignored and must NEVER be committed to git.
#
#   cp .env.example .env
#   # edit .env
#   docker compose up

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# When using docker-compose, this is overridden in docker-compose.yml.
# For local development without Docker: set this to your local Postgres instance.
DATABASE_DSN=postgres://ats:ats_secret@localhost:5432/ats?sslmode=disable

# Redis address in host:port format.
# When using docker-compose, this is overridden in docker-compose.yml.
REDIS_ADDR=localhost:6379

# RSA private key in PEM format (PKCS#1 or PKCS#8).
# Generate a new key:
#   openssl genrsa -out private.pem 2048
# Then paste the contents here (including the -----BEGIN/END----- lines).
# On Linux/macOS you can use:
#   export RSA_PRIVATE_KEY_PEM=$(cat private.pem)
# Keep the newlines — the PEM parser requires them.
# NEVER commit a real private key to git.
RSA_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----
# (paste your key here)
# -----END RSA PRIVATE KEY-----

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Redis AUTH password. Leave empty if Redis has no password (common in dev).
REDIS_PASSWORD=

# HTTP listen address. :8080 means all interfaces on port 8080.
SERVER_ADDR=:8080

# Access token (JWT) lifetime. Short TTL limits blast radius of stolen tokens.
# Format: Go duration string — 15m, 1h, 30s, etc.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime. After expiry the user must re-authenticate.
# 168h = 7 days. Adjust based on your security vs UX requirements.
REFRESH_TOKEN_TTL=168h

# bcrypt work factor for password and client secret hashing.
# Valid range: 10–31. Each increment of 1 doubles computation time.
# 12 ≈ 250ms on modern hardware. Never go below 10.
BCRYPT_COST=12
